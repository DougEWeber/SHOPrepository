#!/usr/bin/env expect
# Shared connection settings for the 5250 test suite.
# Every value can be overridden via environment variable, e.g.:
#   HOST=myhost.example.com PORT=23 ./run.sh

if {[info exists ::env(HOST)]} { set ::HOST $::env(HOST) } else { set ::HOST "services-us-virginia-m-1.skytap.com" }
if {[info exists ::env(PORT)]} { set ::PORT $::env(PORT) } else { set ::PORT "8209" }
if {[info exists ::env(SHOPUSER)]} { set ::USER $::env(SHOPUSER) } else { set ::USER "gittest" }
if {[info exists ::env(SHOPPASS)]} { set ::PASS $::env(SHOPPASS) } else { set ::PASS "gittest" }
if {[info exists ::env(SHOPLIB)]} { set ::LIB $::env(SHOPLIB) } else { set ::LIB "SHOPDEWOBJ" }
