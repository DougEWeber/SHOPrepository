#!/usr/bin/env expect
#
# POMAINT -> Add (F5) with a vendor ID that doesn't exist
# Confirms VENDOR NOT ON FILE is reported.

source [file join [file dirname [info script]] lib.exp]

open_pomnt
press F5
expect {
    "Vendor ID:" { sleep 0.3 }
    timeout { test_fail [test_name] "did not reach po create screen" }
}
type_field "9999999"
enter
expect {
    "VENDOR NOT ON FILE" { test_pass [test_name] "correctly rejected nonexistent vendor 9999999" }
    "PURCHASE ORDER MAINTENANCE" { test_fail [test_name] "add succeeded despite invalid vendor id" }
    timeout { test_fail [test_name] "did not see vendor-not-on-file error" }
}
