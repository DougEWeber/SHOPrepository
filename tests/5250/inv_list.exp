#!/usr/bin/env expect
#
# INVMAINT -> Maintain Inventory -> List (F10)
# Adds an item, then confirms it appears in the scrollable list, that
# Roll Up doesn't crash, and that F12 returns to the maintenance screen.

source [file join [file dirname [info script]] lib.exp]

set item [test_item_id]

open_invmnt
submit $item F5
expect "Item ID:"
type_field "LIST TEST ITEM"; send -- "\t"; type_field "EA"; send -- "\t"
enter
expect {
    "INVENTORY MAINTENANCE" { sleep 0.3 }
    timeout { test_fail [test_name] "setup: could not add item $item" }
}

press F10
expect {
    "INVENTORY LIST" { sleep 0.3 }
    "NO ITEMS ON FILE" { test_fail [test_name] "list came back empty despite adding item $item" }
    timeout { test_fail [test_name] "did not reach inventory list screen" }
}

# Note: $item must be substituted into the pattern, so this uses the
# space-separated `expect -re $pattern { }` form rather than a brace
# block (see cust_search_name.exp for why).
expect -re $item {
    sleep 0.3
} timeout {
    test_fail [test_name] "item $item did not appear in the list"
}

press ROLLUP
expect {
    "Session or device error" { test_fail [test_name] "rolling up crashed the list" }
    "More..."                 { sleep 0.3 }
    "Bottom"                  { sleep 0.3 }
    timeout                   { sleep 0.3 }
}

press F12
expect {
    "INVENTORY MAINTENANCE" { test_pass [test_name] "item $item appeared in the list, roll up and return both worked" }
    timeout { test_fail [test_name] "F12 did not return to the maintenance screen" }
}
