#!/usr/bin/env expect
#
# CUSTMAINT -> Maintain Customer File -> Delete (F7)
# Adds a customer, then deletes it. Customer is one of the few entities
# in this app with a true delete, so the record is fully cleaned up.

source [file join [file dirname [info script]] lib.exp]

set cust [test_cust_num]

open_custmnt_menu
press F5
expect "CUSTOMER FILE MAINTENANCE"
submit $cust F5
expect "Name"
type_field "DELETE ME"; send -- "\t"
type_field "123 MAIN ST"; send -- "\t"
send -- "\t"
type_field "ANYTOWN"; send -- "\t"
# STATE is exactly 2 chars wide; typing "TX" fills it completely and the
# field auto-advances to ZIP, so no explicit Tab is sent here.
type_field "TX"
type_field [test_zip]
enter
expect {
    "CUSTOMER FILE MAINTENANCE" { sleep 0.3 }
    timeout { test_fail [test_name] "setup add did not complete" }
}

submit $cust F7
expect {
    "Customer:" { sleep 0.3 }
    "CUSTOMER NOT ON FILE" { test_fail [test_name] "setup add did not persist -- customer not found on delete" }
    timeout { test_fail [test_name] "did not reach delete confirm screen" }
}
enter
expect {
    "CUSTOMER FILE MAINTENANCE" { sleep 0.3 }
    timeout { test_fail [test_name] "did not confirm delete" }
}
close_session

# --- verify the record is actually gone ---
open_custmnt_menu
press F5
expect "CUSTOMER FILE MAINTENANCE"
submit $cust F8
expect {
    "CUSTOMER NOT ON FILE" { test_pass [test_name] "deleted customer $cust" }
    "Customer:"            { test_fail [test_name] "customer $cust still exists after delete" }
    timeout                 { test_fail [test_name] "did not confirm deletion" }
}
