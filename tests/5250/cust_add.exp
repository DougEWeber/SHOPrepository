#!/usr/bin/env expect
#
# CUSTMAINT -> Maintain Customer File -> Add (F5)
# Adds a new customer record and confirms it's accepted with no error.

source [file join [file dirname [info script]] lib.exp]

set cust [test_cust_num]

open_custmnt_menu
press F5
expect {
    "CUSTOMER FILE MAINTENANCE" { sleep 0.3 }
    timeout { test_fail [test_name] "did not reach customer maintenance HDRSCN" }
}
submit $cust F5
expect {
    "Name" { sleep 0.3 }
    "CUSTOMER ALREADY ON FILE" { test_fail [test_name] "customer $cust already exists (should have been unique)" }
    timeout { test_fail [test_name] "did not reach customer-create screen" }
}
type_field "TEST CUSTOMER"; send -- "\t"
type_field "123 MAIN ST"; send -- "\t"
send -- "\t"
type_field "ANYTOWN"; send -- "\t"
# STATE is exactly 2 chars wide; typing "TX" fills it completely and the
# field auto-advances to ZIP, so no explicit Tab is sent here.
type_field "TX"
type_field [test_zip]
enter
expect {
    "CUSTOMER ALREADY ON FILE" { test_fail [test_name] "unexpected duplicate-customer error on add" }
    "CUSTOMER FILE MAINTENANCE" { test_pass [test_name] "added customer $cust" }
    timeout { test_fail [test_name] "did not confirm add" }
}
