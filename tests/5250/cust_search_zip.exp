#!/usr/bin/env expect
#
# CUSTMAINT -> Search Customer by Zip Code (F6 from main menu)
# Adds a customer with a distinctive zip, then reconnects and searches
# for it, confirming the name appears in the results.

source [file join [file dirname [info script]] lib.exp]

set cust [test_cust_num]
set zip [test_zip]

# --- setup: add a customer with a known zip ---
open_custmnt_menu
press F5
expect "CUSTOMER FILE MAINTENANCE"
submit $cust F5
expect "Name"
type_field "ZIPSEARCH CUSTOMER"; send -- "\t"
type_field "123 MAIN ST"; send -- "\t"
send -- "\t"
type_field "ANYTOWN"; send -- "\t"
# STATE is exactly 2 chars wide; typing "TX" fills it completely and the
# field auto-advances to ZIP, so no explicit Tab is sent here.
type_field "TX"
type_field $zip
enter
expect {
    "CUSTOMER FILE MAINTENANCE" { sleep 0.3 }
    timeout { test_fail [test_name] "setup: could not add customer $cust" }
}
close_session

# --- verify: reconnect, search by zip ---
open_custmnt_menu
press F6
expect {
    "Enter Zip Code" { sleep 0.3 }
    timeout { test_fail [test_name] "did not reach search-by-zip screen" }
}
type_field $zip
enter
expect {
    -re {ZIPSEARCH CUSTOMER} { test_pass [test_name] "search by zip $zip found customer $cust" }
    "ZIP CODE NOT FOUND"     { test_fail [test_name] "setup customer with zip $zip was not found by search" }
    timeout                   { test_fail [test_name] "did not see search results" }
}
