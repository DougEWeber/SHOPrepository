#!/usr/bin/env expect
#
# CUSTMAINT -> Maintain Customer File -> Update (F6) on an unused customer #
# Confirms CUSTOMER NOT ON FILE is reported.

source [file join [file dirname [info script]] lib.exp]

set cust [test_cust_num]

open_custmnt_menu
press F5
expect "CUSTOMER FILE MAINTENANCE"
submit $cust F6
expect {
    "CUSTOMER NOT ON FILE" { test_pass [test_name] "correctly reported unknown customer $cust as not found" }
    "Address"              { test_fail [test_name] "unexpectedly found customer $cust (should not exist)" }
    timeout                 { test_fail [test_name] "did not see not-on-file error" }
}
