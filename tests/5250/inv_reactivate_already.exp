#!/usr/bin/env expect
#
# INVMAINT -> Maintain Inventory -> Reactivate (F8) run on an already-active item
# Confirms ITEM IS ALREADY ACTIVE is reported.

source [file join [file dirname [info script]] lib.exp]

set item [test_item_id]

# --- setup: add + inactivate ---
open_invmnt
submit $item F5
expect "Item ID:"
type_field "TEST WIDGET"; send -- "\t"; type_field "EA"; send -- "\t"
enter
expect "INVENTORY MAINTENANCE"
submit $item F7
expect "Status:"
enter
expect {
    "INVENTORY MAINTENANCE" { sleep 0.3 }
    timeout { test_fail [test_name] "setup: did not confirm inactivate" }
}
close_session

# --- setup 2: reconnect, reactivate once (item is now active) ---
open_invmnt
submit $item F8
expect {
    "Zero QOH" { sleep 0.3 }
    timeout { test_fail [test_name] "setup2: did not reach reactivate confirm screen" }
}
send -- "N"
enter
expect {
    "INVENTORY MAINTENANCE" { sleep 0.3 }
    timeout { test_fail [test_name] "setup2: did not confirm reactivate" }
}
close_session

# --- verify: reconnect fresh, reactivate again --------------------------
open_invmnt
submit $item F8
expect {
    "ITEM IS ALREADY ACTIVE" { test_pass [test_name] "correctly rejected reactivating already-active item $item" }
    "Zero QOH"               { test_fail [test_name] "item was not actually active from setup2" }
    timeout                  { test_fail [test_name] "did not see already-active error" }
}
