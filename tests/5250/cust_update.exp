#!/usr/bin/env expect
#
# CUSTMAINT -> Maintain Customer File -> Update (F6)
# Adds a customer, then updates its name.

source [file join [file dirname [info script]] lib.exp]

set cust [test_cust_num]

open_custmnt_menu
press F5
expect "CUSTOMER FILE MAINTENANCE"
submit $cust F5
expect "Name"
type_field "ORIGINAL NAME"; send -- "\t"
type_field "123 MAIN ST"; send -- "\t"
send -- "\t"
type_field "ANYTOWN"; send -- "\t"
# STATE is exactly 2 chars wide; typing "TX" fills it completely and the
# field auto-advances to ZIP, so no explicit Tab is sent here.
type_field "TX"
type_field [test_zip]
enter
expect {
    "CUSTOMER FILE MAINTENANCE" { sleep 0.3 }
    timeout { test_fail [test_name] "setup add did not complete" }
}

submit $cust F6
expect {
    "Customer:" { sleep 0.3 }
    "CUSTOMER NOT ON FILE" { test_fail [test_name] "setup add did not persist -- customer not found on update" }
    timeout { test_fail [test_name] "did not reach update screen" }
}
type_field "UPDATED NAME        "
enter
expect {
    "CUSTOMER FILE MAINTENANCE" { test_pass [test_name] "updated customer $cust" }
    timeout { test_fail [test_name] "did not confirm update" }
}
