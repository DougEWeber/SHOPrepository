#!/usr/bin/env expect
#
# POMAINT -> List (F10)
# Creates a vendor and PO, then confirms the PO appears in the scrollable
# list, that Roll Up doesn't crash, and that F12 returns to maintenance.

source [file join [file dirname [info script]] lib.exp]

set vndid [create_vendor]
set ponbr [create_po $vndid]

open_pomnt
press F10
expect {
    "PURCHASE ORDER LIST" { sleep 0.3 }
    "NO PURCHASE ORDERS ON FILE" { test_fail [test_name] "list came back empty despite creating po $ponbr" }
    timeout { test_fail [test_name] "did not reach po list screen" }
}

press ROLLUP
expect {
    "Session or device error" { test_fail [test_name] "rolling up crashed the list" }
    "More..." { sleep 0.3 }
    "Bottom"  { sleep 0.3 }
    timeout   { sleep 0.3 }
}

press F12
expect {
    "PURCHASE ORDER MAINTENANCE" { test_pass [test_name] "po list reached for po $ponbr, roll up and return both worked" }
    timeout { test_fail [test_name] "F12 did not return to the maintenance screen" }
}
